/* app.wxss - 全局样式 */
/* 整体配色与原Web版保持一致：紫色渐变 */
page {
  background: #f5f5f5;
  color: #333;
  font-size: 14px;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

/* 卡片容器 */
.card {
  background: #fff;
  border-radius: 12px;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  color: #333;
  display: flex;
  align-items: center;
}

.card-title::before {
  content: "";
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

/* 表单 */
.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #555;
}

.form-input {
  width: 100%;
  padding: 32rpx 24rpx;
  border: 1rpx solid #ddd;
  border-radius: 10rpx;
  font-size: 28rpx;
  background: #fafafa;
  box-sizing: border-box;
}

/* 按钮 */
.btn {
  width: 100%;
  padding: 20rpx 0;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 20rpx;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-success { background: #52c41a; color: #fff; }
.btn-danger { background: #ff4d4f; color: #fff; }
.btn-warning { background: #faad14; color: #fff; }
.btn-info { background: #1890ff; color: #fff; }

.btn[disabled] {
  opacity: 0.5;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.btn-row .btn {
  flex: 1;
  margin-bottom: 0;
}

/* 统计栏 */
.stat-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 20rpx;
}

.stat-item {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  padding: 20rpx;
  border-radius: 10rpx;
  text-align: center;
}

.stat-value { font-size: 36rpx; font-weight: bold; }
.stat-label { font-size: 22rpx; opacity: 0.9; margin-top: 6rpx; }

/* 状态标签 */
.status-badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.status-badge.success {
  background: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

.status-badge.error {
  background: #fff2f0;
  color: #ff4d4f;
  border: 1rpx solid #ffccc7;
}
