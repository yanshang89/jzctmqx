/* pages/config/config.wxss - 配置页面私有样式 */
.keyword-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.keyword-input {
  flex: 1;
}

.search-btn {
  width: auto !important;
  padding: 20rpx 30rpx !important;
  margin-bottom: 0 !important;
  flex-shrink: 0;
}

.checkbox-group {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.checkbox-label {
  font-size: 26rpx;
  color: #555;
}

.btn-default {
  background: #f0f0f0;
  color: #333;
}
