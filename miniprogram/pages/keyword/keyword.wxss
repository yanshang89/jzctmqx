/* pages/keyword/keyword.wxss - 关键词页面私有样式 */
.keyword-list {
  max-height: 800rpx;
}

.keyword-item {
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.keyword-item.selected {
  background: #e6f7ff;
  color: #1890ff;
  font-weight: bold;
}

.check-icon {
  color: #1890ff;
  font-weight: bold;
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
  font-size: 26rpx;
}

.bottom-btns {
  padding: 0 20rpx;
  margin-top: 20rpx;
}
